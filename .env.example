# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=

# Firebase (Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
# Sem estas variáveis, o dev local usa armazenamento em memória.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Blob (Storage > Blob na Vercel). Opcional: sem ele, use URLs de imagem.
BLOB_READ_WRITE_TOKEN=
